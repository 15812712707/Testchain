server {
    listen 443 ssl;
    server_name testchain.example.com;
    ssl_certificate /etc/letsencrypt/live/testchain.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/testchain.example.com/privkey.pem;
    client_max_body_size 11m;

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 120s;
    }
}

server {
    listen 80;
    server_name testchain.example.com;
    return 301 https://$host$request_uri;
}
